# Redes Sociales Oficiales
VITE_INSTAGRAM_URL=https://www.instagram.com/filipocaferesto
VITE_FACEBOOK_URL=https://www.facebook.com/filipocaferesto

# Enlaces directos a perfiles en PedidosYa
VITE_PEYA_TABLAS_URL=https://www.pedidosya.com.ar/restaurantes/salta/filipo-bar-de-tablas-6e94f3ff-329e-40aa-b7c2-b227c1545d93-menu
VITE_PEYA_COFFE_URL=https://www.pedidosya.com.ar/restaurantes/salta/filipo-coffe-menu

# Google Maps (Búsqueda / Ficha comercial)
VITE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Filipo%20Bar%20de%20Tablas%20Salta

# Google Maps Embed (iframe)
VITE_MAPS_EMBED_URL=https://maps.google.com/maps?q=Filipo%20Bar%20de%20Tablas%2C%20Av.%20del%20Bicentenario%20de%20la%20Batalla%20de%20Salta%201401%2C%20Salta&t=&z=16&ie=UTF8&iwloc=&output=embed

